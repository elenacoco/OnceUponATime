# Plane mesh with UVs and normals
# Tangents and bitangents must be computed manually or stored separately

o Plane

v -1.0 0.0 -1.0
v  1.0 0.0 -1.0
v  1.0 0.0  1.0
v -1.0 0.0  1.0

vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

vn 0.0 1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0
vn 0.0 1.0 0.0

# Optional: comment for tangents/bitangents per vertex
tg -1.0 0.0 0.0   # tangent for v0
bt 0.0 0.0 1.0    # bitangent for v0
# ...
# Or compute them from UVs and geometry in code

# Two triangles (1 quad)
f 1/1/1 2/2/2 3/3/3
f 1/1/1 3/3/3 4/4/4

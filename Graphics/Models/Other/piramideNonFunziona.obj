# Piramide con base quadrata e 5 vertici
# Vertici (v): x y z

v -0.5 0.0  0.5   # base front-left
v  0.5 0.0  0.5   # base front-right
v  0.5 0.0 -0.5   # base back-right
v -0.5 0.0 -0.5   # base back-left
v  0.0 1.0  0.0   # vertice alto (punta)

# Facce (f): indicano i triangoli, con indici dei vertici
f 1 2 3   # base triangolo 1
f 1 3 4   # base triangolo 2

f 1 2 5   # lato frontale
f 2 3 5   # lato destro
f 3 4 5   # lato posteriore
f 4 1 5   # lato sinistro

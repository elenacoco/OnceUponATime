<?xml version="1.0" encoding="utf-8"?>

<scene>
	<window>
		<width>1920</width>
		<height>1080</height>
	</window>

	<environment>
		<backgroundColor r="0.1" g="0.1" b="0.2"/>
		<ambientLight r="0.2" g="0.2" b="0.2"/>
	</environment>
	
	<lights>
		<light>
			<type>point</type>
			<position x="0" y="-20" z="30"/>
			<color r="1.0" g="1.0" b="1.0"/>
			<intensity>1</intensity>
		</light>
	</lights>

	<camera>
		<position x="0" y="-70" z="45"/> <!-- pollice verso destra = x, indice che esce da noi = y (y negativa verso di noi), medio verso l'alto = z-->
		<target x="0" y="0" z="0"/>
		<up x="0" y="0" z="1"/> <!-- asse verticale = z	-->
		<fov>45</fov>
	</camera>

	<models>
		<model>
			<name>Libro</name>
			<path>book_on_xz.obj</path>
			<textures>
				<texture type="diffuse">book_diffuse.png</texture>
			</textures>
			<transform>
				<translate x="0" y="0" z="0"/>
				<rotate axis="y" angle="0"/>
				<scale x="0" y="0" z="0"/>
			</transform>
		</model>
		
		<model>
			<name>Pascal</name>
			<path>Pascal.fbx</path>
			<textures>
				<texture type="diffuse">Pascal_diffuse.jpeg</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="0"/>
				<rotate axis="x" angle="90"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="0.5" y="0.5" z="0.5"/>
			</transform>
		</model>
		
		<model>
			<name>Lampada</name>
			<path>lamp.obj</path>
			<textures>
				<texture type="diffuse">Lamp_diffuse.jpg</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="0"/>
				<rotate axis="y" angle="0"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="0.2" y="0.2" z="0.2"/>
			</transform>
		</model>
		
		<model>
			<name>GingerbreadMan</name>
			<path>GBman.obj</path>
			<textures>
				<texture type="diffuse">GBMan_diffuse.png</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="0"/>
				<rotate axis="y" angle="0"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="1" y="1" z="1"/>
			</transform>
		</model>
	</models>

	<animation> <!-- DA CAPIRE SE SERVE-->
		<targetModel>Mela</targetModel>
		<type>rotation</type>
		<axis x="0" y="1" z="0"/>
		<speed>45</speed> <!-- gradi al secondo -->
	</animation>

</scene>
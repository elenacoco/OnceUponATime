<?xml version="1.0" encoding="utf-8"?>

<scene>
	<window>
		<width>1080</width>
		<height>720</height>
	</window>

	<environment>
		<backgroundColor r="0.1" g="0.1" b="0.2"/>
		<ambientLight r="0.2" g="0.2" b="0.2"/>
	</environment>

	<skybox>
		<face>Textures/skyboxGL/right.jpg</face>
		<face>Textures/skyboxGL/left.jpg</face>
		<face>Textures/skyboxGL/top.jpg</face>
		<face>Textures/skyboxGL/bottom.jpg</face>
		<face>Textures/skyboxGL/front.jpg</face>
		<face>Textures/skyboxGL/back.jpg</face>
	</skybox>
	
	<lights>
		<light>
			<type>point</type>
			<position x="0" y="-20" z="30"/>
			<color r="1.0" g="1.0" b="1.0"/>
			<intensity>1</intensity>
		</light>
	</lights>

	<camera>
		<position x="0" y="-50" z="50"/> <!-- pollice verso destra = x, indice che esce da noi = y (y negativa verso di noi), medio verso l'alto = z-->
		<target x="0" y="0" z="0"/>
		<up x="0" y="0" z="1"/> <!-- asse verticale = z	-->
		<fov>45</fov>
		<nearPlane>0.1</nearPlane>
		<farPlane>1000</farPlane>
	</camera>

	<models>
		<model>
			<name>Libro</name>
			<path>Models/Book/libroProva1.obj</path>
			<textures>
				<texture type="diffuse">Models/Book/book_diffuse.png</texture>
				<texture type="specular">Models/Book/book_specular.png</texture>
				<texture type="normal">Models/Book/book_normal.png</texture>
			</textures>
			<transform>
				<translate x="0" y="0" z="0"/>
				<rotate axis="y" angle="0"/>
				<scale x="0" y="0" z="0"/>
			</transform>
		</model>

		<model>
			<name>Pagina</name>
			<path>Models/Page/pagina3_uv_double_sided.obj</path>
			<textures>
				<texture type="diffuse">Models/Page/page_diffuse.png</texture>
			</textures>
			<transform>
				<translate x="0" y="0" z="0"/>
				<rotate axis="y" angle="0"/>
				<scale x="0" y="0" z="0"/>
			</transform>
		</model>
		
		<model>
			<name>Pascal</name>
			<path>Models/Objects/Pascal.fbx</path>
			<textures>
				<texture type="diffuse">Models/Objects/Pascal_diffuse.jpeg</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="0"/>
				<rotate axis="x" angle="90"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="0.5" y="0.5" z="0.5"/>
			</transform>
		</model>
		
		<model>
			<name>Gusgus</name>
			<path>Models/Objects/Gusgus1.obj</path>
			<textures>
				<texture type="diffuse">Models/Objects/gus_diffuse.png</texture>
				<texture type="specular">Models/Objects/gus_specular.png</texture>
				<texture type="specular">Models/Objects/gus_normal.png</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="20"/>
				<rotate axis="y" angle="0"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="0.2" y="0.2" z="0.2"/>
			</transform>
		</model>
		
		<model>
			<name>Lampada</name>
			<path>Models/Objects/lamp1.obj</path>
			<textures>
				<texture type="diffuse">Models/Objects/Lamp_diffuse.jpg</texture>
				<texture type="specular">Models/Objects/lamp_specular.jpg</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="0"/>
				<rotate axis="y" angle="0"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="0.5" y="0.5" z="0.5"/>
			</transform>
		</model>

		<model>
			<name>Merlino</name>
			<path>Models/Objects/MERLINWIZARD.obj</path>
			<textures>
				<texture type="diffuse">Models/Objects/Merlin_diffuse.png</texture>
				<texture type="normal">Models/Objects/Merlin_nm.png</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="20"/>
				<rotate axis="y" angle="0"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="0.2" y="0.2" z="0.2"/>
			</transform>
		</model>
		<model>
			<name>Merlino</name>
			<path>Models/Objects/MERLINWIZARDVACATION.obj</path>
			<textures>
				<texture type="diffuse">Models/Objects/MerlinVacation_diffuse.png</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="20"/>
				<rotate axis="y" angle="0"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="0.2" y="0.2" z="0.2"/>
			</transform>
		</model>

		
		
		<model>
			<name>GingerbreadMan</name>
			<path>Models/Objects/GBman.obj</path>
			<textures>
				<texture type="diffuse">Models/Objects/GBMan_diffuse.png</texture>
			</textures>
			<transform>
				<translate x="0" y="4" z="0"/>
				<rotate axis="y" angle="0"/>
				<scaleIni x="0" y="0" z="0"/>
				<scaleFin x="1" y="1" z="1"/>
			</transform>
		</model>
	</models>

</scene>
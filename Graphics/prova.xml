<?xml version="1.0" encoding="utf-8"?>

<scene>
	<window>
		<width>1080</width>
		<height>720</height>
	</window>

	<environment>
		<backgroundColor r="0.1" g="0.1" b="0.2"/>
		<ambientLight r="0.5" g="0.4" b="0.1"/>
	</environment>

	<skybox>
		<face>Textures/skybox7/right.png</face>
		<face>Textures/skybox7/left.png</face>
		<face>Textures/skybox7/top.png</face>
		<face>Textures/skybox7/bottom.png</face>
		<face>Textures/skybox7/front.png</face>
		<face>Textures/skybox7/back.png</face>
	</skybox>
	
	<lights>
		<light>
			<type>point</type>
			<position x="10" y="30" z="30"/>
			<color r="1.0" g="1.0" b="0.8"/>
			<intensity>1</intensity>
		</light>
	</lights>

	<camera>
		<position x="0" y="-100" z="30"/> <!-- pollice verso destra = x, indice che esce da noi = y (y negativa verso di noi), medio verso l'alto = z-->
		<target x="0" y="0" z="10"/>
		<up x="0" y="0" z="1"/> <!-- asse verticale = z	-->
		<fov>45</fov>
		<nearPlane>0.1</nearPlane>
		<farPlane>1000</farPlane>
	</camera>

